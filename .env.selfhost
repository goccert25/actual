# Absolute path on the host where Actual should keep persistent data.
# Keep this outside the repo so rebuilds and git operations never touch it.
ACTUAL_HOST_DATA_DIR=/Users/george/actual-data

# Host port to expose the server on.
ACTUAL_BIND_PORT=5006

# Optional custom image tag for your locally built fork.
ACTUAL_IMAGE_NAME=actual-local:dev

# Login method for the sync server.
ACTUAL_LOGIN_METHOD=password
