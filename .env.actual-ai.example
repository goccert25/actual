# Actual server credentials and target budget.
ACTUAL_PASSWORD=
ACTUAL_BUDGET_ID=

# Optional. Required only if your budget uses end-to-end encryption.
ACTUAL_E2E_PASSWORD=

# How often actual-ai should run categorization.
CLASSIFICATION_SCHEDULE_CRON=0 */4 * * *

# Safe default setup:
# - classify on startup
# - sync linked accounts before classifying
# - dry run so nothing is modified until you remove "dryRun"
FEATURES=["classifyOnStartup","syncAccountsBeforeClassify","dryRun"]

# LLM provider selection.
LLM_PROVIDER=openai

# OpenAI settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional tags used by actual-ai in transaction notes.
NOT_GUESSED_TAG=#actual-ai-miss
GUESSED_TAG=#actual-ai
